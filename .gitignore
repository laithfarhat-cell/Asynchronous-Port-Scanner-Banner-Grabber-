# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments -------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version

# --- Tooling / caches -----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# --- Scanners' own output (may contain sensitive findings) ----------------
# reports/ is generated by a scan and must never be published. Run
#   git add -f reports/<file>
# to share one deliberately; the committed samples live in examples/.
reports/
*.json.report
scan_*.json
scan_*.csv
scan_*.html
output/
*.tmp

# The signature/preset databases under data/ are source, never ignore them.
!data/*.json

# --- Editors / OS ---------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Local secrets --------------------------------------------------------
.env
.env.*
!.env.example

# Target lists you scan with are local data, never publish them.
# Anchored to the repo root so examples/targets.txt (documentation) is tracked.
/targets.txt
